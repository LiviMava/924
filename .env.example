# Copy this file to .local.env and edit values. Do not commit .local.env.
# Only NAME=VALUE is supported by the Windows loader; values are literal.
# No shell commands, variable interpolation, or inline comments after values.

# Application Bearer token. Empty is supported for local loopback development.
# Required and non-empty for compose. This is separate from model provider keys.
RAG_API_KEY=

# Chat model: DeepSeek OpenAI-compatible endpoint; keep credentials local.
# Obtain the API key from your provider; the project does not generate provider keys.
RAG_CHAT_BASE_URL=https://api.deepseek.com
RAG_CHAT_API_KEY=
RAG_CHAT_MODEL=deepseek-flash

# Embedding is an independent service/model; a Chat key does not configure it.
# Leave the Embedding key empty to use document management + keyword retrieval.
# Zhipu GLM Embedding example (verified endpoint and default 2048-dimension output).
RAG_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=embedding-3
# Must equal actual output size. This validates output; it does NOT request resizing.
RAG_EMBEDDING_DIMENSIONS=2048
# Ingestion batch size (1..64); verify your provider's input-count limit before increasing.
RAG_EMBEDDING_BATCH_SIZE=16

# Qdrant collection prefix; the app appends an embedding-configuration signature.
RAG_QDRANT_COLLECTION=company_chunks_v1
RAG_MIN_VECTOR_SCORE=0.45

# Optional reranker: full HTTP endpoint, e.g. https://reranker.example.com/v1/rerank
# Leave URL and model empty to retain the built-in retrieval ranking.
# Set llm to use the configured chat model for bounded listwise reranking instead.
# Zhipu: URL=https://open.bigmodel.cn/api/paas/v4/rerank, MODEL=rerank.
# Set RAG_RERANK_API_KEY to your Zhipu key (may use the same key as Embedding).
RAG_RERANK_MODE=http
# Zhipu supports raw scores to avoid near-1 rounding saturation; other services may not.
RAG_RERANK_RAW_SCORES=false
RAG_RERANK_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=

# Optional Siemens NX 2512 tools. Start-NxMcp generates a separate local service token.
# Enable only after starting nx-mcp-server and loading the NX bridge in NX.
RAG_MCP_ENABLED=false
RAG_MCP_URL=http://127.0.0.1:8765/mcp
NX_MCP_API_KEY=

# Linux Compose only: supply real non-empty database and Qdrant passwords/tokens.
# Windows Start-Local uses project-local H2 and loopback Qdrant without a Qdrant key.
# Keep RAG_DB_USER commented for Windows H2's default sa; Compose defaults to rag.
# RAG_DB_USER=rag
RAG_DB_PASSWORD=
RAG_QDRANT_API_KEY=

# Optional Windows JDK override; set your own installed JDK 17 path if needed.
# Tutorial APIs are disabled by default; Windows Start-Local enables them for local teaching.
# RAG_TUTORIAL_ENABLED=true
# RAG_HANDBOOK_DIR=./.runtime/handbooks
# JAVA_HOME=C:\path\to\jdk-17
# Start-Local fixes local ports/data/JDBC/Qdrant endpoints; do not put prod URLs here
# expecting that script to switch to PostgreSQL. Use compose for the prod profile.

